---
import Icon from './Icon.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { A } from '../lib/aksen';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  artikel: CollectionEntry<'blog'>['data'];
  /** Indeks <dialog> baca cepat di beranda. Tanpa ini, kartu menjadi link ke halaman artikel. */
  modal?: number;
}
const { lang, artikel: b, modal } = Astro.props;
const t = useTranslations(lang);
const aksi = 'inline-flex items-center gap-1.5 text-sm font-semibold text-ladoob-navy hover:underline underline-offset-4 py-3 -my-3';
---

<article class="flex flex-col bg-white rounded-xl border border-slate-200 p-6 hover:border-slate-300 transition-colors">
  <p class={`text-sm font-semibold ${A[b.aksen].text} mb-2`}>{b.kategori}</p>
  <h3 class="font-heading font-bold text-lg text-ladoob-navy leading-snug mb-3">{b.judul}</h3>
  <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-6">{b.ringkasan}</p>
  <div class="mt-auto flex items-center justify-between gap-4 pt-4 border-t border-slate-100">
    <span class="text-xs text-slate-500">{t('blog.estimate').replace('{n}', String(b.estimasiBaca))}</span>
    {modal !== undefined ? (
      <button type="button" data-open-article={modal} aria-haspopup="dialog" class={aksi}>{t('blog.read')}</button>
    ) : (
      <a href={localizePath(lang, `blog/${b.slug}/`)} class={aksi}>
        {t('blog.readMore')}
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    )}
  </div>
</article>
