---
// GitHub Pages hanya memakai satu 404.html, jadi halaman ini memakai bahasa default.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

const t = useTranslations(defaultLang);
---

<BaseLayout lang={defaultLang} title={t('404.title')} description={t('404.text')} noindex>
  <section class="py-24 sm:py-32 bg-ladoob-slateBg" style="overflow-x: clip;">
    <div class="max-w-xl mx-auto px-4 text-center">
      <p class="font-heading text-5xl font-extrabold text-slate-500 mb-4">404</p>
      <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-ladoob-navy tracking-tight mb-3">{t('404.title')}</h1>
      <p class="text-slate-600 mb-8">{t('404.text')}</p>
      <a href={localizePath(defaultLang)} class="inline-flex items-center justify-center bg-ladoob-navy hover:bg-ladoob-navyDark text-white font-semibold px-6 py-3.5 rounded-lg transition-colors">{t('404.home')}</a>
    </div>
  </section>
</BaseLayout>
